# User identity for the dev container
# =====================================
# Copy this file to .env and fill in your host user and group IDs so that
# files created inside the container are owned by you on the host.
#
# How to find your IDs:
#   id -u   → HOST_UID
#   id -g   → HOST_GID
#
# After editing .env, rebuild the Docker image once:
#   make build-image
#
HOST_UID=1000
HOST_GID=1000

# Android release signing
# ========================
# Required only for `make build-release` and `make build-aab`.
# UPLOAD_STORE_FILE defaults to secret/upload-key.jks (already mounted in the
# container), so you can omit it for local builds.
#
UPLOAD_STORE_FILE=/app/secret/upload-key.jks
UPLOAD_STORE_PASSWORD=
UPLOAD_KEY_ALIAS=
UPLOAD_KEY_PASSWORD=
